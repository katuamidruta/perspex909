---
type Props = {
  youtubeId: string;
  index: number;
};

const { youtubeId, index } = Astro.props;
const thumbUrl = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
---

<div class="reel-item" data-reel data-yt={youtubeId} style={`--i:${index}`}>
  <div class="reel-overlay" aria-hidden="true">
    <img src={thumbUrl} alt="" class="reel-overlay__thumb" loading="lazy" decoding="async" />
    <div class="reel-overlay__scrim"></div>
    <button class="reel-play" type="button" aria-label={`Play reel ${index + 1}`}>
      <svg width="22" height="24" viewBox="0 0 22 24" fill="none" aria-hidden="true">
        <path d="M2 2L20 12L2 22V2Z" fill="currentColor"/>
      </svg>
    </button>
  </div>
</div>

---
import { navItems, site } from "@data/site";

// The centred logo already links home, so an "INDEX" item would just repeat
// it. Dropping it also leaves an even count that splits cleanly either side.
const links = navItems.filter((item) => item.href !== "/");
const half = Math.ceil(links.length / 2);
const numbered = links.map((item, index) => ({
  ...item,
  no: String(index + 1).padStart(2, "0"),
}));
---

<header class="site-header">
  <nav class="site-nav site-nav--l" aria-label="Archive and releases">
    {
      numbered.slice(0, half).map((item) => (
        <a href={item.href}>
          <span>{item.no}</span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <a class="site-mark" href="/" aria-label={`${site.name} home`}>
    <img src="/logo.png" alt={site.displayName} />
  </a>

  <nav class="site-nav site-nav--r" aria-label="Shop and information">
    {
      numbered.slice(half).map((item) => (
        <a href={item.href}>
          <span>{item.no}</span>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

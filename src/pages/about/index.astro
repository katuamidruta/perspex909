---
import BaseLayout from "@layouts/BaseLayout.astro";
import GalleryMarquee from "@components/GalleryMarquee.astro";

const fragments = [
  { src: "/archive/random1-6.webp", size: "tall" },
  { src: "/archive/random1-7.webp", size: "wide" },
  { src: "/archive/random1-1.webp", size: "short" },
  { src: "/archive/random1-8.webp", size: "base" },
  { src: "/archive/random1-2.webp", size: "tall" },
  { src: "/archive/random1-9.webp", size: "wide" },
  { src: "/archive/random1-3.webp", size: "short" },
  { src: "/archive/random1-10.webp", size: "base" },
  { src: "/archive/random1-4.webp", size: "tall" },
  { src: "/archive/random1-11.webp", size: "wide" },
  { src: "/archive/random1-5.webp", size: "short" }
];
---

<BaseLayout title="Manifesto" description="Perspex909 manifesto and platform direction." theme="paper">
  <section class="page-head">
    <div class="page-head__center" data-reveal>
      <p class="hero__kicker">00 / Manifesto</p>
      <h1 class="about-logo-head"><img src="/logo.png" alt="PERSPEX909" class="about-logo" /></h1>
    </div>
  </section>

  <section class="section">
    <div class="split" data-reveal>
      <div class="copy-block">
        <p class="meta-label">Platform</p>
        <h2>Sound, vision, and expression without boundaries.</h2>
        <p>
          Perspex909 is an independent electronic music platform from Indonesia: part magazine, part label archive, part release portal, part artifact shop, part event and flyer index.
        </p>
        <p>
          Perspex909 documents raw sound, physical releases, visual culture, and the fragments that usually disappear into feeds.
        </p>
        <p>
          The site is built as an archive first. Releases carry catalog codes and tracklists. Products are physical documents. Flyers hold dates, cities, venues, lineups, and grain.
        </p>
        <p>
          The tone stays direct: no corporate gloss, no lifestyle fog, no generic discovery language. Perspex is a record of transmissions that happened, are happening, and still need somewhere to live.
        </p>
      </div>
      <dl class="meta-table">
        <div>
          <dt>Base</dt>
          <dd>Indonesia / SEA</dd>
        </div>
        <div>
          <dt>Format</dt>
          <dd>Magazine, release archive, artifact shop</dd>
        </div>
        <div>
          <dt>Signals</dt>
          <dd>Flyers, scans, USBs, zines, tracklists</dd>
        </div>
        <div>
          <dt>Checkout</dt>
          <dd>Bandcamp</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--paper">
    <div class="section-header" data-reveal>
      <div>
        <p class="section-kicker">Visual Culture</p>
        <h2 class="section-title">Archive Fragments</h2>
      </div>
      <p class="section-summary">
        A selection of images from the Perspex field archive. Shot documentation, event residue, and atmospheric evidence.
      </p>
    </div>
    <GalleryMarquee images={fragments} alt="Perspex — archive documentation" />
  </section>
</BaseLayout>

---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Manifesto" description="Perspex909 manifesto and platform direction." theme="paper">
  <section class="page-head">
    <div class="page-head__grid" data-reveal>
      <div>
        <p class="hero__kicker">00 / Manifesto</p>
        <h1 class="page-title">Transmission Desk</h1>
      </div>
      <div class="about-logo-frame">
        <img src="/logo.png" alt="PERSPEX909" class="about-logo" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="split" data-reveal>
      <div class="copy-block">
        <p class="meta-label">Platform</p>
        <h2>Sound, vision, and expression without boundaries.</h2>
        <p>
          Perspex909 is an independent electronic music platform from Indonesia: part magazine, part label archive, part release portal, part artifact shop, part event and flyer index.
        </p>
        <p>
          Perspex909 documents underground sound, physical releases, visual culture, and the fragments that usually disappear into feeds.
        </p>
        <p>
          The site is built as an archive first. Releases carry catalog codes and tracklists. Products are physical documents. Flyers hold dates, cities, venues, lineups, and grain.
        </p>
        <p>
          The tone stays direct: no corporate gloss, no lifestyle fog, no generic discovery language. Perspex is a record of transmissions that happened, are happening, and still need somewhere to live.
        </p>
      </div>
      <dl class="meta-table">
        <div>
          <dt>Base</dt>
          <dd>Indonesia / SEA</dd>
        </div>
        <div>
          <dt>Format</dt>
          <dd>Magazine, release archive, artifact shop</dd>
        </div>
        <div>
          <dt>Signals</dt>
          <dd>Flyers, scans, USBs, zines, tracklists</dd>
        </div>
        <div>
          <dt>Checkout</dt>
          <dd>Bandcamp</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--metal">
    <div class="section-header" data-reveal>
      <div>
        <p class="section-kicker">Visual Culture</p>
        <h2 class="section-title">Archive Fragments</h2>
      </div>
      <p class="section-summary">
        A selection of images from the Perspex field archive. Shot documentation, event residue, and atmospheric evidence.
      </p>
    </div>
    <div class="visual-archive" data-reveal>
      <div class="visual-archive__item">
        <img src="/archive/random1-6.webp" alt="Perspex — archive documentation" loading="lazy" />
      </div>
      <div class="visual-archive__item">
        <img src="/archive/random1-1.webp" alt="Perspex — archive documentation" loading="lazy" />
      </div>
      <div class="visual-archive__item">
        <img src="/archive/random1-2.webp" alt="Perspex — archive documentation" loading="lazy" />
      </div>
      <div class="visual-archive__item">
        <img src="/archive/random1-3.webp" alt="Perspex — archive documentation" loading="lazy" />
      </div>
      <div class="visual-archive__item">
        <img src="/archive/random1-4.webp" alt="Perspex — archive documentation" loading="lazy" />
      </div>
      <div class="visual-archive__item">
        <img src="/archive/random1-5.webp" alt="Perspex — archive documentation" loading="lazy" />
      </div>
    </div>
  </section>
</BaseLayout>

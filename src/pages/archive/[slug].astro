---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductGallery from "@components/ProductGallery.astro";
import MetaTable from "@components/MetaTable.astro";
import ReelPlayer from "@components/ReelPlayer.astro";
import { events, type ArchiveEntry } from "@data/events";

export function getStaticPaths() {
  return events.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: ArchiveEntry };
const realGalleryImages = entry.galleryImages.filter((img) => img.src);
---

<BaseLayout title={entry.title} description={entry.summary}>
  <section class="page-head">
    <div class="page-head__grid" data-reveal>
      <div data-drift="-0.012">
        <p class="hero__kicker">{entry.date} / {entry.location}</p>
        <h1 class="page-title">{entry.title}</h1>
      </div>
      <div class="flyer-frame" data-parallax="0.02">
        {entry.flyerImage.src ? (
          <img src={entry.flyerImage.src} alt={entry.flyerImage.alt} />
        ) : (
          <div class="media-placeholder" role="img" aria-label={entry.flyerImage.alt}>
            <span>{entry.flyerImage.label}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section section--archive-detail">
    <div class="split" data-reveal>
      <div class="copy-block">
        <p class="meta-label">Archive Note</p>
        <h2>{entry.summary}</h2>
        {entry.description.map((paragraph) => <p>{paragraph}</p>)}
        {entry.links.length > 0 && (
          <div class="cta-row">
            {entry.links.map((link) => (
              <a class="cta" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
            ))}
          </div>
        )}
      </div>
      <MetaTable
        items={[
          { label: "Date", value: entry.date },
          { label: "Location", value: entry.location },
          { label: "Tags", value: entry.tags.join(" / ") }
        ]}
      />
    </div>
  </section>

  <section class="section section--paper">
    <div class="section-header" data-reveal>
      <div>
        <p class="section-kicker">Credits / Lineup</p>
        <h2 class="section-title">People In The Room</h2>
      </div>
      <p class="section-summary">
        Structured so event collaborators, performers, visual teams, and future credits remain readable as archive metadata.
      </p>
    </div>
    <div class="archive-sections" data-reveal>
      {entry.sections.map((section) => (
        <section class="archive-section">
          <h3>{section.title}</h3>
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>

  {entry.soundcloudUrl && (
    <section class="section section--metal">
      <div class="section-header" data-reveal>
        <div>
          <p class="section-kicker">Transmission / Recording</p>
          <h2 class="section-title">Listen</h2>
        </div>
        <p class="section-summary">
          Set recordings archived from the event. Full playlist on SoundCloud.
        </p>
      </div>
      <div class="soundcloud-embed" data-reveal>
        <iframe
          width="100%"
          height="450"
          allow="autoplay"
          style="border: none;"
          src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(entry.soundcloudUrl)}&color=%23e73737&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&visual=true`}
          title={`${entry.title} — SoundCloud Playlist`}
        ></iframe>
        <div class="soundcloud-footer">
          <a href={entry.soundcloudUrl} target="_blank" rel="noopener noreferrer" class="cta">
            Open Full Playlist on SoundCloud
          </a>
        </div>
      </div>
    </section>
  )}

  {realGalleryImages.length > 0 && (
    <section class="section">
      <div class="section-header" data-reveal>
        <div>
          <p class="section-kicker">Gallery</p>
          <h2 class="section-title">Event Archive</h2>
        </div>
        <p class="section-summary">
          Photography and visual documentation from the event.
        </p>
      </div>
      <div data-reveal>
        <ProductGallery images={realGalleryImages} />
      </div>
    </section>
  )}

  {entry.videos && entry.videos.length > 0 && (
    <section class="section">
      <div class="section-header" data-reveal>
        <div>
          <p class="section-kicker">Visual Record</p>
          <h2 class="section-title">Field Footage</h2>
        </div>
        <p class="section-summary">
          Short-form documentation captured on the ground.
        </p>
      </div>
      <div class="reels-grid" data-reveal>
        {entry.videos.map((video, i) => (
          <ReelPlayer youtubeId={video.youtubeId} label={video.label} index={i} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

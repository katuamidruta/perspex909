---
import BaseLayout from "@layouts/BaseLayout.astro";
import ReelPlayer from "@components/ReelPlayer.astro";
import { events } from "@data/events";
import { products } from "@data/products";
import { releases } from "@data/releases";
import { navItems, site } from "@data/site";

const va01 = releases[0];
const tee = products[0];

const words = (line: string) => line.split(" ");

// 01 — HERO SPLIT. One frame pulled apart into a band.
const wings = {
  left: [
    { src: "/archive/campout1-2.webp", alt: "Perspex floor documentation" },
    { src: "/archive/random1-7.webp", alt: "Perspex floor documentation" },
  ],
  right: [
    { src: "/archive/random1-12.webp", alt: "Perspex floor documentation" },
    { src: "/archive/random1-13.webp", alt: "Perspex floor documentation" },
  ],
};

// 02 — DECK. Three statements on a split-flap.
const deck = ["Platform & Space.", "Sound & Vision.", "Without Boundaries."];

// 03 — BIO burn-in.
const bio =
  "Perspex909 is a platform and space for exploring sound, vision, and expression without boundaries, built around experimentation and independence, beyond rigid structures, trends, and expectations; not a collective, not a label, just a space to explore, create, and experiment.";

// 04 — LEDGER. The label metadata that used to live on the manifesto page.
const ledger = [
  { label: "Base", value: "Bali" },
  { label: "Format", value: "Spaces + Archives" },
  { label: "Signals", value: "Collaborations" },
  { label: "Platform", value: "Digital" },
];

// 05 — STACK. What deals into the pile — one card per event, top to bottom
// in this order. Swap any src here; the dossier in 06 keeps drawing the
// flyers from events.ts either way. (While these were the same three files,
// the pile cost nothing extra; each different src here is one more image.)
const stackCards = [
  {
    src: "/archive/random1-12.webp",
    alt: "Perspex909 — field documentation",
  },
  {
    src: "/archive/campout1-3.webp",
    alt: "Campout Vol. II — field documentation",
  },
  {
    src: "/archive/random1-14.webp",
    alt: "Entering 2026 Portal — field documentation",
  },
];

// 06 — DOSSIER. Each record unrolls in place: the flyer held on the left,
// the sheet writing itself out on the right, one row at a time.
type Row = { kind: string; label?: string; text: string };

const dossier = events.map((entry) => {
  const rows: Row[] = [
    { kind: "kicker", text: `${entry.date} · ${entry.location}` },
    { kind: "title", text: entry.title },
    { kind: "lead", text: entry.summary },
    ...entry.description.map((text) => ({ kind: "note", text })),
    ...entry.sections.map((section) => ({
      kind: "group",
      label: section.title,
      text: section.items.join(" · "),
    })),
    { kind: "tags", text: entry.tags.join(" / ") },
  ];
  return { entry, rows };
});

// 07 — FIELD FOOTAGE. One YouTube id per reel, in strip order — swap or
// reorder here. Click to play: no iframe is requested until someone asks.
// The reels carry no captions; the footage is the label.
const reels = [
  "dWe98fos33A",
  "eYIwajoW79E",
  "WLbuRljvAQI",
  "9reRu_1P1LQ",
  "2XaIlZDpxMI",
  "x3HOoeCP6Z4",
];

// 08 — RELEASE REEL. Same split mechanism as the opening frame, so the two
// video moments rhyme.
const reelWings = {
  left: [
    { src: "/archive/prod1-12.webp", alt: "PRSPX tee" },
    { src: "/archive/prod1-10.webp", alt: "Field documentation" },
  ],
  right: [
    { src: "/archive/prod1-6.webp", alt: "VA01 USB" },
    { src: "/archive/prod1-11.webp", alt: "Field documentation" },
  ],
};

// 09 — SPECS.
const specs = [
  { label: "Catalog", value: va01.catalogCode },
  { label: "Tracks", value: String(va01.trackCount) },
  { label: "Year", value: va01.releaseDate.slice(0, 4) },
  { label: "Format", value: "USB + Zine" },
];

// 11 — CHRONICLE. Layered frames cross-dissolving under cycling statements.
// Drawn from the release's own documentation, so the scene under the
// tracklist is the record it is counting.
const chronicleLayers = [
  va01.coverImage,
  ...va01.galleryImages!.slice(0, 3).map((img) => img.src),
];
const chronicleLines = [
  "Thirty-six tracks.",
  "One scene document.",
  "Pressed to hold.",
];

// 12 — ARTIFACT OVERTURE. The same split mechanism that opens the page and
// the release chapter, opening the last one — the tee's own photographs
// pulled apart into a band, with the product shot holding the core.
const teeWings = {
  left: [tee.reviewPhotos[0], tee.userPhotos[0]],
  right: [tee.userPhotos[1], tee.reviewPhotos[1]],
};

// 13 — ARTIFACT. Two columns of field photographs travelling in opposite
// directions behind the order sheet.
const teeColumns = [
  [tee.heroImage, tee.reviewPhotos[0], tee.userPhotos[0]],
  [tee.userPhotos[1], tee.reviewPhotos[1], tee.userPhotos[2]],
];

// 14 — MENU. The closing block is the same menu as the header, built from
// the same array, so the two can never drift apart. Off-site accounts live
// in the footer; a menu that points out of the document is not a menu.
const menuMeta: Record<string, string> = {
  "#archive": `${events.length} records`,
  "#release": `${va01.catalogCode} / ${va01.trackCount} tracks`,
  "#artifact": tee.soldOut ? "Sold out" : tee.priceLabel,
  "#label": "Manifesto",
};

const menuRows = navItems.map((item, i) => ({
  ...item,
  meta: menuMeta[item.href] ?? "",
  no: String(i + 1).padStart(2, "0"),
}));
---

<BaseLayout title={site.displayName} description={site.description}>
  {/* ---------- 01 · HERO SPLIT ------------------------------------- */}
  <section class="split-frame runway--3" data-scrub>
    <div class="stage">
      <div class="split-band">
        <div class="split-wing split-wing--l">
          {
            wings.left.map((img) => (
              <figure>
                <img src={img.src} alt={img.alt} loading="eager" />
              </figure>
            ))
          }
        </div>

        <div class="split-core">
          <video
            muted
            loop
            playsinline
            preload="none"
            poster="/archive/campout1-4.webp"
            data-src="/hero.mp4"
            data-bg-video></video>
        </div>

        <div class="split-wing split-wing--r">
          {
            wings.right.map((img) => (
              <figure>
                <img src={img.src} alt={img.alt} loading="eager" />
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 02 · DECK ------------------------------------------- */}
  <section class="deck runway--4" data-scrub>
    <div class="stage">
      <div class="deck-rack" style={`--n:${deck.length}`}>
        {
          deck.map((line, i) => (
            <h2
              class:list={["deck-line", i === deck.length - 1 && "is-last"]}
              style={`--i:${i}; --wn:${words(line).length}`}
            >
              {words(line).map((w, wi) => (
                <span style={`--w:${wi}`}>{w}</span>
              ))}
            </h2>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- 03 · BIO ------------------------------------------- */}
  <section class="bio runway--3" id="label" data-scrub>
    <div class="stage">
      <div class="bio-inner">
        <p class="section-kicker">Perspex909</p>
        <p class="burn burn--lead" style={`--n:${words(bio).length}`}>
          {words(bio).map((w, i) => <span style={`--i:${i}`}>{w}</span>)}
        </p>
      </div>
    </div>
  </section>

  {/* ---------- 04 · LEDGER ----------------------------------------- */}
  <section class="section--metal ledger">
    <dl class="spec-grid">
      {
        ledger.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="ledger-line" data-in="up">
      Space where sound, vision, and ideas take form.
    </p>
  </section>

  {
    /* The archive arrives off the back of a metadata grid, which is a hard
      stop to read against. Same held breath as the one before the release
      reel — unlabelled, so it stays a gap and not an announcement. */
  }
  <div class="interlude" aria-hidden="true"></div>

  {/* ---------- 05 · STACK ------------------------------------------ */}
  <section class="stack runway--4" id="archive" data-scrub>
    <div class="stage">
      <!-- <div class="stack-counter">
        {String(stackCards.length).padStart(2, "0")}
      </div> -->
      <div class="stack-table" style={`--n:${stackCards.length}`}>
        {
          stackCards.map((card, i) => (
            <div
              class:list={[
                "stack-card",
                i === stackCards.length - 1 && "is-last",
              ]}
              style={`--i:${i}`}
            >
              <figure>
                <img
                  src={card.src}
                  alt={card.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- 06 · DOSSIER ---------------------------------------- */}
  <section class="dossier runway--5" data-scrub>
    <div class="stage">
      <div class="dossier-deck" style={`--n:${dossier.length}`}>
        {
          dossier.map(({ entry, rows }, i) => (
            <article
              class:list={[
                "dossier-sheet",
                i === dossier.length - 1 && "is-last",
              ]}
              style={`--i:${i}; --rn:${rows.length + 1}`}
            >
              <figure class="dossier-flyer">
                <img
                  src={entry.flyerImage.src}
                  alt={entry.flyerImage.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <div class="dossier-record">
                {rows.map((row, r) => (
                  <div
                    class={`dossier-row dossier-row--${row.kind}`}
                    style={`--r:${r}`}
                  >
                    {row.label && <h3>{row.label}</h3>}
                    {row.kind === "title" ? (
                      <h2>{row.text}</h2>
                    ) : (
                      <p>{row.text}</p>
                    )}
                  </div>
                ))}

                {entry.soundcloudUrl && (
                  <div
                    class="dossier-row dossier-row--link"
                    style={`--r:${rows.length}`}
                  >
                    <a
                      class="cta"
                      href={entry.soundcloudUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Recording on SoundCloud
                    </a>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- 07 · FIELD FOOTAGE ---------------------------------- */}
  <section class="reels runway--4" data-scrub>
    <div class="stage">
      <div class="reels-head">
        <p class="section-kicker">Visual Record</p>
        <h2 class="section-title">Field Footage</h2>
      </div>

      <div class="reel-strip" style={`--n:${reels.length}`}>
        {reels.map((id, i) => <ReelPlayer youtubeId={id} index={i} />)}
      </div>
    </div>
  </section>

  {
    /* A held breath. Deliberately empty and unlabelled — naming what is
      coming spends the surprise that carries the scroll. */
  }
  <div class="interlude" aria-hidden="true"></div>

  {/* ---------- 08 · RELEASE REEL (split II) ------------------------ */}
  <section class="split-frame runway--3" id="release" data-scrub>
    <div class="stage">
      <div class="split-band">
        <div class="split-wing split-wing--l">
          {
            reelWings.left.map((img) => (
              <figure>
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>

        <div class="split-core">
          <video
            muted
            loop
            playsinline
            preload="none"
            data-poster="/archive/prod1-1.webp"
            data-src="/archive/compilation.mp4"
            data-src-narrow="/archive/compilation-720.mp4"
            data-bg-video></video>
        </div>

        <div class="split-wing split-wing--r">
          {
            reelWings.right.map((img) => (
              <figure>
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 09 · SPECS ------------------------------------------ */}
  <section class="section--metal">
    <dl class="spec-grid">
      {
        specs.map((spec) => (
          <div>
            <dt>{spec.label}</dt>
            <dd>{spec.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="release-note" data-in="up">
      <p class="release-lead">{va01.summary}</p>
      {va01.notes.map((note) => <p>{note}</p>)}
      <p class="release-credits">
        {
          va01.credits.map((credit, i) => (
            <Fragment>
              {i > 0 && " · "}
              {credit.role + " "}<strong>{credit.names.join(" & ")}</strong>
            </Fragment>
          ))
        }
      </p>
      <div class="cta-row">
        <a class="cta cta--signal" href={va01.links.bandcamp}>Bandcamp</a>
        <a class="cta" href={va01.links.preview}>SoundCloud Preview</a>
      </div>
    </div>
  </section>

  {/* ---------- 10 · TRACKLIST LADDER ------------------------------- */}
  <section
    class="ladder runway--4"
    style={`--n:${va01.tracklist.length}`}
    data-scrub
  >
    <div class="stage">
      <div class="ladder-head">
        <p class="section-kicker">Tracklist Sheet</p>
        <p class="ladder-count" aria-hidden="true"></p>
      </div>
      <p class="sr-only">{va01.trackCount} tracks on {va01.catalogCode}</p>
      <div class="ladder-window">
        <span class="ladder-cursor" aria-hidden="true"></span>
        <div class="ladder-list">
          {
            va01.tracklist.map((track, i) => (
              <div class="ladder-row" style={`--i:${i}`}>
                <span class="ladder-row__no">
                  {String(track.number).padStart(2, "0")}
                </span>
                <span class="ladder-row__artist">{track.artist}</span>
                <span class="ladder-row__title">{track.title}</span>
                <span class="ladder-row__dur">{track.duration ?? "--:--"}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 11 · CHRONICLE -------------------------------------- */}
  <section class="chronicle runway--4" data-scrub>
    <div class="stage">
      <div class="chronicle-scene">
        {
          chronicleLayers.map((src, i) => (
            <img
              class="chronicle-layer"
              style={`--s:${(i / chronicleLayers.length).toFixed(3)}`}
              src={src}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ))
        }
        <div class="chronicle-veil"></div>
      </div>

      <div class="chronicle-lines" style={`--n:${chronicleLines.length}`}>
        {
          chronicleLines.map((line, i) => (
            <h2
              class="chronicle-line"
              style={`--i:${i}; --wn:${words(line).length}`}
            >
              {words(line).map((w, wi) => (
                <span style={`--w:${wi}`}>{w}</span>
              ))}
            </h2>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- 12 · ARTIFACT OVERTURE (split III) ------------------ */}
  <section class="split-frame runway--3" data-scrub>
    <div class="stage">
      <div class="split-band">
        <div class="split-wing split-wing--l">
          {
            teeWings.left.map((img) => (
              <figure>
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>

        <div class="split-core">
          <img
            src={tee.heroImage.src}
            alt={tee.heroImage.alt}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="split-wing split-wing--r">
          {
            teeWings.right.map((img) => (
              <figure>
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 13 · ARTIFACT --------------------------------------- */}
  <section class="artifact runway--3" id="artifact" data-scrub>
    <div class="stage">
      <div class="artifact-columns" aria-hidden="true">
        {
          teeColumns.map((column, c) => (
            <div class={`artifact-column artifact-column--${c}`}>
              {[...column, ...column].map((img) => (
                <figure>
                  <img src={img.src} alt="" loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          ))
        }
      </div>
      <div class="artifact-veil"></div>

      <div class="artifact-sheet">
        <p class="section-kicker">
          {tee.artifactType} / {tee.soldOut ? "Sold out" : tee.availability} /{
            " "
          }
          {tee.catalogCode}
        </p>
        <h2 class="section-title">{tee.title}</h2>
        <p class="artifact-lead">{tee.summary}</p>
        <p class="artifact-note">{tee.description[0]}</p>
        <p class="artifact-price">
          {tee.soldOut ? "Sold out" : tee.priceLabel}
        </p>
        <p class="artifact-note">{tee.description[1]}</p>
        <p class="artifact-credit">
          {
            tee.credits
              .map((credit) => `${credit.label} ${credit.value}`)
              .join(" · ")
          }
        </p>
        <div class="cta-row">
          <a
            class="cta cta--signal"
            href={tee.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            >{tee.soldOut ? "Ask about the next run" : "Order via WhatsApp"}</a
          >
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 14 · MENU ------------------------------------------- */}
  <section class="section section--paper index-block" data-readout>
    <div class="section-header" data-in="up">
      <div>
        <p class="section-kicker">Menu</p>
        <h2 class="section-title">Go Back In</h2>
      </div>
    </div>

    <div class="index-readout">{String(menuRows.length).padStart(2, "0")}</div>

    <div class="index-list" data-in="up" style="--d:120ms">
      {
        menuRows.map((row) => (
          <a class="index-row" href={row.href} data-no={row.no}>
            <span class="index-row__no">{row.no}</span>
            <span class="index-row__title">{row.label}</span>
            <span class="index-row__meta">{row.meta}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

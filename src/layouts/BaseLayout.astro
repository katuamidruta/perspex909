---
import SiteHeader from "@components/SiteHeader.astro";
import { site } from "@data/site";
import "../styles/global.css";
import "../styles/motion.css";

type Props = {
  title?: string;
  description?: string;
  theme?: "dark" | "paper";
  image?: string;
};

const {
  title = site.displayName,
  description = site.description,
  theme = "dark",
  image = "/logo.png",
} = Astro.props;

const pageTitle =
  title === site.displayName ? title : `${title} / ${site.displayName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-loading.png" />

    <!-- The display face carries every heading and the chrome type, so it is
         on the critical path; the mono is metadata and can arrive late. -->
    <link
      rel="preload"
      href="/fonts/archivo-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.displayName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={site.displayName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <div class="site-loader" aria-label="Loading Perspex archive">
      <div class="site-loader__mark">
        <img src="/logo-loading.png" alt="" />
      </div>
      <div class="site-loader__scan" aria-hidden="true"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/" class="footer-logo-link" aria-label="PERSPEX909 home">
        <img src="/logo.png" alt="PERSPEX909" class="footer-logo" />
      </a>
      <span class="footer-copy">2026 &copy; PRSPX. All Rights Reserved.</span>
      {/* The official accounts live here and only here — the menu points
          into the document, never out of it. */}
      <div>
        <a href={site.bandcampUrl}>Bandcamp</a>
        <a href={site.soundcloudUrl}>SoundCloud</a>
        <a href={site.instagramUrl}>Instagram</a>
      </div>
    </footer>
    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      window.addEventListener("load", () => {
        document.body.classList.add("is-loaded");
      });

      // --- Header height ---------------------------------------------------
      // Sections that pin below the header need its real height, and the
      // header re-wraps at narrow widths. Measuring it beats guessing a
      // breakpoint value that goes stale the moment a nav label changes.
      const header = document.querySelector(".site-header");
      if (header) {
        const publishHeaderHeight = () =>
          document.documentElement.style.setProperty(
            "--header-h",
            Math.round(header.getBoundingClientRect().height) + "px",
          );
        publishHeaderHeight();
        if ("ResizeObserver" in window) {
          new ResizeObserver(publishHeaderHeight).observe(header);
        } else {
          window.addEventListener("resize", publishHeaderHeight);
        }
      }

      // Background/hero videos: attach the source lazily as each enters the
      // viewport, so heavy below-fold clips never download until they're near.
      // Poster stands in for save-data and reduced-motion users.
      const conn = navigator.connection || {};
      const saveData = conn.saveData === true;
      const bgVideos = document.querySelectorAll("[data-bg-video]");

      const posterVideos = document.querySelectorAll("[data-poster]");
      if (posterVideos.length) {
        const attachPoster = (video) => {
          video.poster = video.getAttribute("data-poster");
        };
        if ("IntersectionObserver" in window) {
          const posterObserver = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  attachPoster(entry.target);
                  obs.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "600px 0px" },
          );
          posterVideos.forEach((video) => posterObserver.observe(video));
        } else {
          posterVideos.forEach(attachPoster);
        }
      }

      if (bgVideos.length && !reduceMotion && !saveData) {
        const attachVideo = (video) => {
          const src = video.getAttribute("data-src");
          if (!src || video.src) return;
          video.src = src;
          video.load();
          const attempt = video.play();
          if (attempt && attempt.catch) attempt.catch(() => {});
        };

        if ("IntersectionObserver" in window) {
          const videoObserver = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  attachVideo(entry.target);
                  obs.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "300px 0px" },
          );
          bgVideos.forEach((video) => videoObserver.observe(video));
        } else {
          bgVideos.forEach(attachVideo);
        }
      }

      // --- Reveals -------------------------------------------------------
      // Re-armable: the class comes off only once the element is fully out
      // of view, so scrolling back up replays it without mid-screen flicker.
      const revealTargets = document.querySelectorAll("[data-in]");

      if ("IntersectionObserver" in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.intersectionRatio >= 0.15) {
                entry.target.classList.add("is-in");
              } else if (entry.intersectionRatio === 0) {
                entry.target.classList.remove("is-in");
              }
            });
          },
          { threshold: [0, 0.15, 0.5] },
        );

        revealTargets.forEach((target) => revealObserver.observe(target));
      } else {
        revealTargets.forEach((target) => target.classList.add("is-in"));
      }

      // --- Scrub engine ---------------------------------------------------
      // Each [data-scrub] runway publishes one number, --p (0 → 1), tracking
      // how far it has travelled. Every choreography in motion.css is a pure
      // CSS function of that number, so nothing here knows what it animates.
      const scrubTargets = Array.from(document.querySelectorAll("[data-scrub]"));

      if (scrubTargets.length && !reduceMotion) {
        let scrubQueued = 0;

        // A runway's travel is measured against ITS OWN STAGE, not the window.
        // Runways are authored in svh, which is fixed to the small viewport,
        // while window.innerHeight grows the moment a phone's URL bar
        // retracts. Dividing the first by the second made --p jump ~4% at
        // that exact moment — every choreography on the page snapped at once
        // — and made --p hit 1 while the stage was still pinned, which is the
        // frozen hold this project has twice been told off for. The stage is
        // the thing that actually unpins, so it is the correct ruler.
        const measure = (target) => {
          const stage = target.querySelector(".stage");
          target._stageH = stage ? stage.offsetHeight : window.innerHeight;
        };

        const measureAll = () => scrubTargets.forEach(measure);

        const paintScrub = () => {
          scrubQueued = 0;
          const viewport = window.innerHeight;

          for (const target of scrubTargets) {
            const rect = target.getBoundingClientRect();
            // Skip runways nowhere near the viewport; their last painted
            // value (0 below, 1 above) is already the correct end state.
            if (rect.bottom < -viewport || rect.top > viewport * 2) continue;

            const stageH = target._stageH || viewport;
            const range = target.offsetHeight - stageH;
            const progress =
              range > 0
                ? -rect.top / range
                : (stageH - rect.top) / (stageH + rect.height);

            target.style.setProperty(
              "--p",
              (progress < 0 ? 0 : progress > 1 ? 1 : progress).toFixed(4),
            );
          }
        };

        const requestScrub = () => {
          if (!scrubQueued) scrubQueued = requestAnimationFrame(paintScrub);
        };

        measureAll();
        paintScrub();
        window.addEventListener("scroll", requestScrub, { passive: true });
        window.addEventListener("resize", () => {
          measureAll();
          requestScrub();
        });
      }

      // --- Index readout --------------------------------------------------
      // Hovering a row drives the oversized number, so one cursor move
      // changes the row, its siblings, and the counter together.
      document.querySelectorAll("[data-readout]").forEach((block) => {
        const readout = block.querySelector(".index-readout");
        if (!readout) return;
        const resting = readout.textContent;
        const rows = block.querySelectorAll(".index-row");

        if (window.matchMedia("(hover: hover)").matches) {
          rows.forEach((row) => {
            row.addEventListener("mouseenter", () => {
              readout.textContent = row.getAttribute("data-no") || resting;
            });
          });

          block.addEventListener("mouseleave", () => {
            readout.textContent = resting;
          });
        } else {
          // A phone has no cursor, so the counter was frozen at its resting
          // number for the whole session — the block's one piece of
          // interaction, dead. Scroll position cannot stand in for the cursor
          // here: the menu is the last block on the page, so its rows can
          // never be scrolled to the middle of the screen (measured — the
          // document ends 125px below the last row). The touch itself is the
          // input that does exist. The number lands before the anchor jump,
          // so it reads as "you left from 03".
          rows.forEach((row) => {
            row.addEventListener(
              "pointerdown",
              () => {
                readout.textContent = row.getAttribute("data-no") || resting;
              },
              { passive: true },
            );
          });
        }
      });

      // Reel click-to-play (YouTube Shorts embed).
      // Only the reel under the head answers a tap: every other tile in the
      // strip renders its play button at opacity 0 but stayed fully
      // clickable, so on a phone a tap on an apparently empty tile started a
      // video. And a reel that scrolls out from under the head gives its
      // iframe back, rather than playing on off-screen inside a clipped
      // stage — which also re-arms the tile for the next time round.
      const playingReels = new Set();

      const focusOf = (reel) =>
        parseFloat(getComputedStyle(reel).getPropertyValue("--focus")) || 0;

      const stopReel = (reel) => {
        const frame = reel.querySelector("iframe");
        if (frame) frame.remove();
        reel.classList.remove("is-playing");
        playingReels.delete(reel);
      };

      document.querySelectorAll("[data-reel]").forEach((reel) => {
        const overlay = reel.querySelector(".reel-overlay");
        const ytId = reel.dataset.yt;
        if (!overlay || !ytId) return;

        overlay.addEventListener("click", () => {
          // In the strip the tile has a --focus; anywhere else it does not,
          // and every tile answers.
          const inStrip = reel.closest(".reel-strip");
          if (inStrip && focusOf(reel) < 0.5) return;
          if (reel.classList.contains("is-playing")) return;

          reel.classList.add("is-playing");
          playingReels.add(reel);

          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0&playsinline=1`;
          iframe.allow = "autoplay; fullscreen; picture-in-picture";
          iframe.allowFullscreen = true;
          iframe.style.cssText =
            "position:absolute;inset:0;width:100%;height:100%;border:0;";
          reel.appendChild(iframe);
        });
      });

      window.addEventListener(
        "scroll",
        () => {
          if (!playingReels.size) return;
          playingReels.forEach((reel) => {
            if (focusOf(reel) < 0.3) stopReel(reel);
          });
        },
        { passive: true },
      );
    </script>
  </body>
</html>

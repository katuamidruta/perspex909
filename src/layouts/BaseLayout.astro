---
import SiteHeader from "@components/SiteHeader.astro";
import { site } from "@data/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  theme?: "dark" | "paper";
  image?: string;
};

const {
  title = site.displayName,
  description = site.description,
  theme = "dark",
  image = "/logo.png"
} = Astro.props;

const pageTitle = title === site.displayName ? title : `${title} / ${site.displayName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-loading.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.displayName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={site.displayName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <div class="site-loader" aria-label="Loading Perspex archive">
      <div class="site-loader__mark">
        <img src="/logo-loading.png" alt="" />
      </div>
      <div class="site-loader__scan" aria-hidden="true"></div>
    </div>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/" class="footer-logo-link" aria-label="PERSPEX909 home">
        <img src="/logo.png" alt="PERSPEX909" class="footer-logo" />
      </a>
      <span class="footer-copy">2026 &copy; PRSPX. All Rights Reserved.</span>
      <div class="footer-right">
        <div>
          <a href={site.bandcampUrl}>Bandcamp</a>
          <a href={site.instagramUrl}>Instagram</a>
        </div>
        <div class="site-credit">
          <img src="/kucingdigital.png" alt="kucingdigital" class="site-credit__logo" />
          <span>built by kucingdigital</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const compactViewport = window.matchMedia("(max-width: 800px)").matches;

      window.addEventListener("load", () => {
        document.body.classList.add("is-loaded");
      });

      // Background/hero videos: attach the source lazily as each enters the
      // viewport, so heavy below-fold clips never download until they're near.
      // Poster stands in for save-data and reduced-motion users.
      const conn = navigator.connection || {};
      const saveData = conn.saveData === true;
      const bgVideos = document.querySelectorAll("[data-bg-video]");

      if (bgVideos.length && !reduceMotion && !saveData) {
        const attachVideo = (video) => {
          if (compactViewport && video.hasAttribute("data-no-mobile")) return;
          const src = video.getAttribute("data-src");
          if (!src || video.src) return;
          video.src = src;
          video.load();
          const attempt = video.play();
          if (attempt && attempt.catch) attempt.catch(() => {});
        };

        if ("IntersectionObserver" in window) {
          const videoObserver = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  attachVideo(entry.target);
                  obs.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "300px 0px" }
          );
          bgVideos.forEach((video) => videoObserver.observe(video));
        } else {
          bgVideos.forEach(attachVideo);
        }
      }

      const revealTargets = document.querySelectorAll("[data-reveal]");

      if ("IntersectionObserver" in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.22, rootMargin: "0px 0px -8% 0px" }
        );

        revealTargets.forEach((target) => revealObserver.observe(target));
      } else {
        revealTargets.forEach((target) => target.classList.add("is-revealed"));
      }

      if (!reduceMotion && !compactViewport) {
        const parallaxTargets = document.querySelectorAll("[data-parallax], [data-drift]");
        let ticking = false;

        const updateMotion = () => {
          const viewportMiddle = window.innerHeight / 2;

          parallaxTargets.forEach((target) => {
            const rect = target.getBoundingClientRect();
            const distance = rect.top + rect.height / 2 - viewportMiddle;

            if (target.hasAttribute("data-parallax")) {
              const strength = Number(target.getAttribute("data-parallax") || "0.04");
              target.style.transform = `translate3d(0, ${distance * strength}px, 0)`;
            }

            if (target.hasAttribute("data-drift")) {
              const strength = Number(target.getAttribute("data-drift") || "0.025");
              target.style.transform = `translate3d(${distance * strength}px, 0, 0)`;
            }
          });

          ticking = false;
        };

        const requestMotion = () => {
          if (!ticking) {
            window.requestAnimationFrame(updateMotion);
            ticking = true;
          }
        };

        updateMotion();
        window.addEventListener("scroll", requestMotion, { passive: true });
        window.addEventListener("resize", requestMotion);
      }

      // Reel click-to-play (YouTube Shorts embed)
      document.querySelectorAll("[data-reel]").forEach((reel) => {
        const overlay = reel.querySelector(".reel-overlay");
        if (!overlay) return;

        overlay.addEventListener("click", () => {
          const ytId = reel.dataset.yt;
          if (!ytId) return;
          reel.classList.add("is-playing");
          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0&playsinline=1`;
          iframe.allow = "autoplay; fullscreen; picture-in-picture";
          iframe.allowFullscreen = true;
          iframe.style.cssText = "position:absolute;inset:0;width:100%;height:100%;border:0;";
          reel.appendChild(iframe);
        }, { once: true });
      });
    </script>
  </body>
</html>
